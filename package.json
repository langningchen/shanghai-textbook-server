{
	"name": "shanghai-textbook-server",
	"version": "0.1.0",
	"packageManager": "pnpm@12.4.1",
	"private": true,
	"scripts": {
		"dev": "next dev --turbopack",
		"build": "next build --turbopack",
		"start": "next start",
		"lint": "next lint",
