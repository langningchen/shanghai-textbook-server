		"@opennextjs/cloudflare": "^1.20.8",
		"next": "16.3.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-intersection-observer": "^11.0.1"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"eslint": "^9.39.5",
		"eslint-config-next": "16.2.12",
		"typescript": "^6.0.3",
		"wrangler": "^4.147.0"
